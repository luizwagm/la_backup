[Unit]
Description=LA Backup — todo dia de madrugada

[Timer]
# 04:00 em ponto, por decisao do dono do servidor.
OnCalendar=*-*-* 04:00:00
# Sem espalhamento: "as 4h" tem de significar as 4h. A versao anterior sorteava
# ate 20 minutos para nao disputar banda caso surgisse um segundo servidor;
# hoje ha um so, e a hora previsivel vale mais — e ela que deixa dizer, olhando
# o relogio, se o backup de hoje ja passou. Se um dia houver um segundo
# servidor, o lugar de voltar a espalhar e esta linha.
RandomizedDelaySec=0
# Se a maquina estava desligada na hora, roda assim que ligar. Sem isto, um
# reboot as 04:00 pula o backup do dia inteiro, calado.
Persistent=true

[Install]
WantedBy=timers.target
